{
  "name": "aperture-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.cjs",
    "dev": "node scripts/build-wasm.cjs && vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "node scripts/build-wasm.cjs && vite build",
    "test": "node scripts/build-wasm.cjs && node --test tests/*.test.js",
    "tauri": "tauri",
    "test:e2e": "node scripts/build-wasm.cjs && node scripts/smoke.cjs",
    "format": "prettier --write src tests e2e *.json *.js",
    "demo:capture": "node scripts/capture-demo.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tauri-apps/cli": "^2.0.0",
    "prettier": "^3.5.3",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lightweight-charts": "5.2.1"
  }
}
